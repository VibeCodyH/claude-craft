# crunch credentials — copy to ~/.config/claude-craft/crunch.env
#
# Every line is optional. A provider with no key is skipped and the chain moves on,
# so one key is enough to start. A real environment variable always wins over this
# file. Keep this file out of any project directory that holds production secrets:
# crunch only reads the variables listed here, and only from this path.
#
# Chain order (edit PROVIDERS in tools/crunch.mjs to change it):
#   openrouter -> cerebras -> groq -> zai -> mistral -> cloudflare -> local

# openrouter.ai — free `:free` model slugs behind a hard daily cap. The free slugs
# rotate; `crunch --models openrouter | grep ':free'` lists the ones live today.
OPENROUTER_API_KEY=

# cloud.cerebras.ai — the workhorse: large model, very fast, generous daily quota.
CEREBRAS_API_KEY=

# console.groq.com
GROQ_API_KEY=

# z.ai
ZAI_API_KEY=

# console.mistral.ai. VIBE_API_KEY is read as a fallback, since the `vibe` CLI keeps
# its Mistral key under that name and there is no reason to store it twice.
MISTRAL_API_KEY=

# Cloudflare Workers AI needs BOTH of these. Smallest free quota, so it sits last.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# --- model overrides (ids drift; `crunch --models <provider>` lists the live ones) ---
# CRUNCH_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# CRUNCH_CEREBRAS_MODEL=gpt-oss-120b
# CRUNCH_GROQ_MODEL=openai/gpt-oss-120b

# --- the local floor: any OpenAI-compatible server (Ollama, LM Studio, llama.cpp) ---
# Leave the model unset and crunch uses the first one the server reports.
# CRUNCH_LOCAL_BASE=http://localhost:11434/v1
# CRUNCH_LOCAL_MODEL=
